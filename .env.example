# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API).
# VITE_SUPABASE_ANON_KEY is the public "anon" key, not a secret — it's safe
# in a client bundle. Every table it can touch is locked down by the RLS
# policies in supabase/schema.sql, not by hiding this key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
